# =========================================================
# SyDRA - Configuration EN LIGNE (template sans secrets)
# =========================================================
# Copiez ce fichier et remplacez chaque valeur <> avant de deployer.
# Ne commitez jamais de vraies cles, mots de passe ou tokens.

APP_NAME=SyDRA
APP_ENV=production
APP_URL=https://<votre-domaine>
APP_DEBUG=false
APP_LOCALE=fr

# -------------------------
# Base de donnees MySQL (production)
# -------------------------
DB_HOST=<db-host>
DB_PORT=3306
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASS=<db-pass>

# Clés externes
GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# -------------------------
# Emails / SMTP (production)
# -------------------------
MAIL_FROM=<no-reply@votre-domaine>
MAIL_FROM_NAME=SyDRA Notifications
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURE=tls
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-pass>

# Email support visible dans l'application
# Contact secondaire recommande: it@fosip-drc.org
SUPPORT_EMAIL=emmanuelkubiha@gmail.com
