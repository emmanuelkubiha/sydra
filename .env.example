# =========================================================
# SyDRA - Exemple de configuration environnement
# =========================================================
# Local: utilisez localhost et les ports MAMP.
# Production: mettez les vraies valeurs serveur (domaine, DB, SMTP).

APP_NAME=SyDRA
APP_ENV=local
# Production (exemple): APP_ENV=production
# Production (exemple): APP_URL=https://sydra.fosip-drc.org
APP_URL=http://localhost:8888/SyDRA
APP_DEBUG=true
APP_LOCALE=fr

# -------------------------
# Base de donnees MySQL
# -------------------------
# Production: ne gardez pas root/root.
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=sydra
DB_USER=root
DB_PASS=root

GOOGLE_MAPS_API_KEY=

# -------------------------
# Emails / SMTP
# -------------------------
# IMPORTANT:
# - SMTP_HOST doit etre renseigne en production.
# - Pour Gmail: utilisez un mot de passe d'application (pas le mot de passe du compte).
# - SMTP_USER doit correspondre au compte qui genere le mot de passe d'application.
# - En cas d'erreur "Could not authenticate", verifier utilisateur/mot de passe/app-password.
MAIL_FROM=noreply@sydra.local
MAIL_FROM_NAME=SyDRA Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURE=tls
SMTP_USER=ton_adresse@gmail.com
SMTP_PASS=mot_de_passe_d_application

# Email contact support visible dans l'application
SUPPORT_EMAIL=it@fosip-drc.org
